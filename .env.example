# 이 파일을 복사해 .env.local로 만들고 실제 값을 채워넣으세요.
# .env.local은 .gitignore로 제외되어 있으니 실제 키를 여기(.env.example)에는 절대 채우지 마세요.

# Firebase Admin SDK — 서비스 계정 키(JSON)에서 값을 그대로 옮겨온다.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# 개행이 포함된 PEM 키 — 큰따옴표로 감싸고 개행은 \n으로 이스케이프해서 한 줄로 넣는다.
FIREBASE_PRIVATE_KEY=

# 카카오 로그인 (Kakao Developers > 앱 설정 > 카카오 로그인)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 네이버 로그인 (Naver Developers)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# OpenRouter — AI 상세 사주 리포트/채팅 생성에 사용
OPENROUTER_API_KEY=
# 선택. 지정하지 않으면 lib/llm.ts의 기본 모델(deepseek/deepseek-chat)을 쓴다.
OPENROUTER_MODEL=

# 관리자 페이지 접근 허용 uid 목록(콤마로 구분, 예: kakao_123,naver_456).
# lib/session.ts의 makeUid() 형식(provider_providerId)을 따라야 한다 — 이메일 아님.
ADMIN_UIDS=

# 운세 상세 콘텐츠를 전부 무료로 볼 수 있게 하는 임시 캠페인 스위치(lib/config.ts).
# 지정하지 않으면 기본 true(전체 무료)로 동작한다. 정식 유료 전환 시 false로 설정.
NEXT_PUBLIC_FREE_PREVIEW=true
